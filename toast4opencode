#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PS_SCRIPT_WIN="$(wslpath -w "${SCRIPT_DIR}/scripts/toast4opencode.ps1")"

if command -v pwsh.exe >/dev/null 2>&1; then
  PS_EXE="pwsh.exe"
elif command -v powershell.exe >/dev/null 2>&1; then
  PS_EXE="powershell.exe"
else
  echo "toast4opencode: neither pwsh.exe nor powershell.exe is available in WSL2." >&2
  exit 1
fi

"${PS_EXE}" -NoLogo -NoProfile -ExecutionPolicy Bypass -File "${PS_SCRIPT_WIN}" "$@"
